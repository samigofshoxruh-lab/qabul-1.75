{
  "name": "crm-bot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:text": "DENO_NO_PACKAGE_JSON=1 deno test --allow-env --no-prompt tests/text.test.ts",
    "test:sql": "tests/stack/pg.sh start && node --test tests/sql.test.mjs",
    "test:e2e": "tests/stack/pg.sh start && node --test --test-force-exit tests/e2e.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource/golos-text": "^5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "deno": "^2.0.0",
    "pg": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
